<UserControl x:Class="MediaPlayer.Controls.AudioVisualPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220"
             MinWidth="300">
    <UserControl.Resources>
        <Storyboard x:Key="AmbientStoryboard">
            <DoubleAnimation Storyboard.TargetName="OuterRingScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.08" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="OuterRingScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.08" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="OuterRing" Storyboard.TargetProperty="Opacity" From="0.18" To="0.42" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InnerRingScale" Storyboard.TargetProperty="ScaleX" From="1.04" To="0.9" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InnerRingScale" Storyboard.TargetProperty="ScaleY" From="1.04" To="0.9" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InnerRing" Storyboard.TargetProperty="Opacity" From="0.36" To="0.14" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="OrbitRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:36" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ParticleOneTransform" Storyboard.TargetProperty="X" From="-8" To="12" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ParticleOne" Storyboard.TargetProperty="Opacity" From="0.25" To="0.8" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ParticleTwoTransform" Storyboard.TargetProperty="Y" From="10" To="-14" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ParticleTwo" Storyboard.TargetProperty="Opacity" From="0.2" To="0.65" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#06080C" ClipToBounds="True">
        <Ellipse Width="410" Height="410" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4D64D8E8" Offset="0" />
                    <GradientStop Color="#1A9B8CFF" Offset="0.46" />
                    <GradientStop Color="#0006080C" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Width="310" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="OuterRing" Width="290" Height="290" Stroke="{StaticResource CyanBrush}" StrokeThickness="1" Opacity="0.24">
                <Ellipse.RenderTransform><ScaleTransform x:Name="OuterRingScale" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="InnerRing" Width="205" Height="205" Stroke="{StaticResource VioletBrush}" StrokeThickness="1" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform><ScaleTransform x:Name="InnerRingScale" /></Ellipse.RenderTransform>
            </Ellipse>
            <Canvas Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform x:Name="OrbitRotation" /></Canvas.RenderTransform>
                <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" Canvas.Left="146" Canvas.Top="3" Opacity="0.75" />
                <Ellipse Width="5" Height="5" Fill="{StaticResource VioletBrush}" Canvas.Left="286" Canvas.Top="172" Opacity="0.6" />
            </Canvas>
            <Ellipse x:Name="ParticleOne" Width="5" Height="5" Fill="{StaticResource CyanBrush}" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42,56,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleOneTransform" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="ParticleTwo" Width="4" Height="4" Fill="{StaticResource VioletBrush}" Opacity="0.35" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,62">
                <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleTwoTransform" /></Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="210">
                <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionCaptionStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="trackTitle" Text="Audio ready" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                <TextBlock x:Name="stateLabel" Text="Ready to play" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
            <UniformGrid x:Name="spectrumBars" Rows="1" Columns="32" Height="112" VerticalAlignment="Bottom" Margin="25,0,25,22" />
        </Grid>
    </Grid>
</UserControl>
