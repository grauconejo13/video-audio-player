<Window x:Class="MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoAudioPlayer"
        mc:Ignorable="d" 
        Title="MainWindow" Height="600" Width="800">

    <Grid Margin="5,5,5,5">


        <MediaElement x:Name="mediaElement" Margin="10,3,10,60" Height="350" Width="700" LoadedBehavior="Manual" />

        <StackPanel  Margin="25,425,25,15" HorizontalAlignment="Center" Height="100" Width="335">
            <Label x:Name="lblStatus" Content="Not playing..." d:Background="ghostwhite" HorizontalContentAlignment="Center"  Width="276" Height="80" />
            <WrapPanel Width="275" Height="50" Margin="5,-45,5,5" >
                <Button x:Name="OpenBtnAudioFile"  FontSize="8" Margin="5,0" Click="openBtnMediaFile_Click" Height="30" Width="45" Content="Open File" />
                <Button x:Name="btnPlay" Click="btnPlay_Click" Content="Play"/>
                <Button x:Name="btnPause" Margin="5,0" Click="btnPause_Click" Content="Pause"/>
                <Button x:Name="btnStop" Click="btnStop_Click" Content="Stop"/>
                <Button x:Name="btnReset" Click="btnReset_Click" Content="Reset"/>
            </WrapPanel>
        </StackPanel>
    </Grid>

</Window>
