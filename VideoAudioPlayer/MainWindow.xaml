<Window x:Class="MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Audio Player" Height="600" Width="800">
    <Grid Margin="5">
        <MediaElement x:Name="mediaElement"
                      Margin="10,3,10,120"
                      Height="350"
                      Width="700"
                      LoadedBehavior="Manual" />

        <StackPanel Margin="25,405,25,15"
                    HorizontalAlignment="Center"
                    Width="420">
            <Label x:Name="lblCurrentItem"
                   Content="No file selected"
                   HorizontalContentAlignment="Center" />
            <Label x:Name="lblStatus"
                   Content="No file selected"
                   HorizontalContentAlignment="Center" />
            <WrapPanel HorizontalAlignment="Center" Margin="5">
                <Button x:Name="btnOpenMediaFiles" Margin="5,0" Click="openBtnMediaFile_Click" Content="Open Files" />
                <Button x:Name="btnPrevious" Margin="5,0" Click="btnPrevious_Click" Content="Previous" />
                <Button x:Name="btnPlay" Margin="5,0" Click="btnPlay_Click" Content="Play" />
                <Button x:Name="btnPause" Margin="5,0" Click="btnPause_Click" Content="Pause" />
                <Button x:Name="btnStop" Margin="5,0" Click="btnStop_Click" Content="Stop" />
                <Button x:Name="btnReset" Margin="5,0" Click="btnReset_Click" Content="Reset" />
                <Button x:Name="btnNext" Margin="5,0" Click="btnNext_Click" Content="Next" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
