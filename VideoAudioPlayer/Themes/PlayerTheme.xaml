<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="GalaxyBlackColor">#090B12</Color>
    <Color x:Key="SurfaceColor">#111622</Color>
    <Color x:Key="SurfaceRaisedColor">#182031</Color>
    <Color x:Key="BorderColor">#253045</Color>
    <Color x:Key="PrimaryTextColor">#F3F4F5</Color>
    <Color x:Key="SecondaryTextColor">#9DA9BB</Color>
    <Color x:Key="CyanColor">#6FE3ED</Color>
    <Color x:Key="VioletColor">#A493FF</Color>

    <SolidColorBrush x:Key="GalaxyBlackBrush" Color="{StaticResource GalaxyBlackColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <LinearGradientBrush x:Key="GalaxyBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090B12" Offset="0" />
        <GradientStop Color="#0E1220" Offset="0.48" />
        <GradientStop Color="#121125" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9151B28" Offset="0" />
        <GradientStop Color="#D90E1420" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource GalaxyBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="#752A3547" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.22" /></Setter.Value></Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="#E1182030" />
        <Setter Property="BorderBrush" Value="#8C2B384C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B464D8E8" /><Setter TargetName="ButtonBorder" Property="Background" Value="#F0202B3D" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F0111723" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.36" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#E01B3A43" />
        <Setter Property="BorderBrush" Value="#B264D8E8" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#3364D8E8" BlurRadius="10" ShadowDepth="0" Opacity="0.35" /></Setter.Value></Setter>
    </Style>

    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter Property="Padding" Value="0" /></Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="Padding" Value="13,11" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#C91A3441" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8C64D8E8" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#991A2231" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" /><Setter Property="Background" Value="#4D516077" /><Setter Property="Height" Value="22" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Margin="0,8"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" BorderThickness="0" Height="3" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="11" Height="11" Background="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" BorderThickness="0" Height="3" /></Track.IncreaseRepeatButton></Track></Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Opacity" Value="0.86" /></Style>
</ResourceDictionary>
